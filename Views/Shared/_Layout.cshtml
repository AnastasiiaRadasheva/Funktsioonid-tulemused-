<!DOCTYPE html>
<html lang="@T.Keel">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#be123c" />
    <title>@ViewData["Title"] – @T["Исследование функций", "Funktsioonide uurimine"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/sait.css" rel="stylesheet" asp-append-version="true" />
    <script>window.KEEL = '@T.Keel'; window.t = (ru, et) => window.KEEL === 'ru' ? ru : et;</script>
    <script>
        // Keele vahetamisel jääb kasutaja samasse kohta: sama aadress, sama kerimiskoht ja kalkulaatori olek
        (function () {
            const VOTI = 'keeleVahetus';
            let salvestatud = null;
            try { salvestatud = JSON.parse(sessionStorage.getItem(VOTI)); sessionStorage.removeItem(VOTI); } catch { }
            const praegu = location.pathname + location.search;
            window.KEELE_OLEK = salvestatud && salvestatud.tee === praegu ? salvestatud : null;

            document.addEventListener('click', e => {
                const link = e.target.closest('.keelevalik a');
                if (!link) return;
                // aadress võib pärast lehe laadimist muutunud olla (kalkulaator uuendab seda) – võtame praeguse
                const url = new URL(link.href, location.origin);
                url.searchParams.set('tagasi', location.pathname + location.search);
                link.href = url.pathname + url.search;
                const olek = Object.assign({ tee: location.pathname + location.search, y: window.scrollY },
                    window.koguKeeleOlek ? window.koguKeeleOlek() : {});
                try { sessionStorage.setItem(VOTI, JSON.stringify(olek)); } catch { }
            });

            if (window.KEELE_OLEK) {
                if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
                window.taastaKerimine = () => window.scrollTo(0, window.KEELE_OLEK.y);
                // sisu võib laadimise järel veel kasvada (KaTeX, graafikud) – taastame paar korda
                window.addEventListener('load', () => { window.taastaKerimine(); setTimeout(window.taastaKerimine, 400); });
            }
        })();
    </script>
</head>
<body>
    @{
        var kontroller = ViewContext.RouteData.Values["controller"] as string;
        var tegevus = ViewContext.RouteData.Values["action"] as string;
        string Aktiivne(string k, string? t = null) =>
            k == kontroller && (t == null || t == tegevus) ? "aktiivne" : "";
        var praegune = Context.Request.Path + Context.Request.QueryString;
    }
    <nav class="riba">
        <div class="container riba-sisu">
            <a class="logo" asp-controller="Home" asp-action="Index"><span class="logo-ikoon">f(x)</span><span class="logo-tekst">@T["Исследование функций", "Funktsioonide uurija"]</span></a>
            <div class="menuu">
                <a class="@Aktiivne("Home", "Index")" asp-controller="Home" asp-action="Index">@T["Калькулятор", "Kalkulaator"]</a>
                <a class="@Aktiivne("Home", "Juhend")" asp-controller="Home" asp-action="Juhend">@T["Справочник", "Juhend"]</a>
                <a class="@Aktiivne("Funktsioonid")" asp-controller="Funktsioonid" asp-action="Index">@T["Сохранённые", "Salvestatud"]</a>
                <span class="keelevalik" role="group" aria-label="@T["Язык", "Keel"]">
                    <a class="@(T.OnVene ? "" : "valitud")" asp-controller="Home" asp-action="Keel" asp-route-keel="et" asp-route-tagasi="@praegune" hreflang="et" title="Eesti keel">ET</a>
                    <a class="@(T.OnVene ? "valitud" : "")" asp-controller="Home" asp-action="Keel" asp-route-keel="ru" asp-route-tagasi="@praegune" hreflang="ru" title="Русский язык">RU</a>
                </span>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Teade"] is string teade)
        {
            <div class="alert alert-success">@teade</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
